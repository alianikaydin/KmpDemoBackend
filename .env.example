# Copy to .env (scripts/server-up.sh creates it with random secrets when missing).
# Never commit .env or real values.
DATABASE_USER=kmpdemo
DATABASE_PASSWORD=
JWT_SECRET=
# Optional overrides (defaults shown):
# PORT=8081
# DATABASE_POOL_SIZE=10
# DB_MIGRATE_ON_START=true
# ACCESS_TOKEN_TTL=PT15M
# REFRESH_TOKEN_TTL=P30D
# CORS_ALLOWED_ORIGINS=
# RATE_LIMIT_AUTH_PER_MINUTE=20
# LOG_FORMAT=plain
# SWAGGER_ENABLED=false
# Force-update policy per platform: MAJOR.MINOR.PATCH, min <= latest, 0.0.0 = no update.
# APP_ANDROID_MIN_SUPPORTED_VERSION=0.0.0
# APP_ANDROID_LATEST_VERSION=0.0.0
# APP_IOS_MIN_SUPPORTED_VERSION=0.0.0
# APP_IOS_LATEST_VERSION=0.0.0
